+    if require_complete:
+        check(len(completed_answers)==planned_answers,f'Completed answers: {len(completed_answers)}/{planned_answers}')
+        primary=[s for s in completed_scores if s.get('kind')=='primary']
+        repeat=[s for s in completed_scores if s.get('kind')=='repeat']
+        check(len(primary)==planned_answers,f'Completed primary scores: {len(primary)}/{planned_answers}')
