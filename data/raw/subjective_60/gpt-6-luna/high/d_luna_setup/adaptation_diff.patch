+        check(len(repeat)==planned_repeats,f'Completed repeat scores: {len(repeat)}/{planned_repeats}')
+        check({s['run_id'] for s in repeat}==set(manifest['repeat_score_run_ids']),'Repeat selection mismatch')
+    cleanup_check_deferred = not require_complete and (out/'.running.lock').exists()
+    if not cleanup_check_deferred:
+        check(not list((root/'work/private_runtime').rglob('config.toml')),'Temporary config remains')
+        check(not list((root/'work/private_runtime').rglob('auth.json')),'Temporary auth remains')
+    config_path=Path.home()/'.codex/config.toml'
+    secret_values=[]
+    if config_path.exists():
+        cfg=tomllib.loads(config_path.read_text(encoding='utf-8'))
+        secret_values.extend(v for provider in cfg.get('model_providers',{}).values() for k,v in provider.items()
+            if isinstance(v,str) and ('token' in k.lower() or 'key' in k.lower()) and len(v)>12)
+    for path in out.rglob('*'):
