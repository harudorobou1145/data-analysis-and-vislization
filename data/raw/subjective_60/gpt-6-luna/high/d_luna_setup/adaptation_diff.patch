+    thread_ids=[r.get('thread_id') for r in runtimes]
+    request_ids=[r.get('request_id') for r in runtimes]
+    check(None not in thread_ids and len(thread_ids)==len(set(thread_ids)),'Thread reuse or missing IDs')
+    check(None not in request_ids and len(request_ids)==len(set(request_ids)),'Duplicate/missing request IDs')
+    attempt_files=list((out/'attempts').glob('*/*.json'))
